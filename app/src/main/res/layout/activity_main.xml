<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
     android:background="@color/white"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imgfonfondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/fondo_imagen"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

<!--Crear tarjeta princpal-->
    <androidx.cardview.widget.CardView
        android:id="@+id/contenedor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="30dp"
        app:cardElevation="35dp"
        app:cardCornerRadius="25dp"
        android:backgroundTint="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="345dp">


    <TextView
        android:id="@+id/tvtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inicio de sesión"
        android:textColor="#FF99FF"
        android:textSize="30dp"
        android:textStyle="bold"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/etcorreo"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/bg_input"
        android:hint="Correo electrónico"
        android:paddingStart="20dp"
        android:paddingEnd="15dp"
        android:textColor="#333333"
        android:textColorHint="#FFCDBF"
        android:inputType="textEmailAddress"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/baseline_email_24"/>

        <EditText
            android:id="@+id/etpassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_input"
            android:hint="Contraseña"
            android:paddingStart="20dp"
            android:paddingEnd="15dp"
            android:textColor="#333333"
            android:textColorHint="#FFCDBF"
            android:inputType="textPassword"
            android:drawablePadding="10dp"
            android:layout_marginTop="15dp"
            android:drawableStart="@drawable/baseline_admin_panel_settings_24"/>

       <androidx.appcompat.widget.AppCompatButton
           android:id="@+id/btningresar"
           android:layout_width="match_parent"
           android:layout_height="55dp"
           android:background="@drawable/bg_buttom"
           android:layout_marginTop="20dp"
           android:text="INGRESAR"
           android:textColor="#FFFFFF"
           android:textStyle="bold"
           android:textSize="15sp"/>

       <TextView
           android:id="@+id/tvcrearcuenta"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="Crear una cuenta ->"
           android:layout_marginTop="60dp"
           android:layout_marginBottom="20dp"
           android:textStyle="bold"
           android:textColor="#9966FF"/>


    </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>